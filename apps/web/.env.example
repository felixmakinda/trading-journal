# Copy to .env.local for development; set the same names in Vercel for production.

# Supabase project (Settings > API). The secret key bypasses RLS: server only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Public URL of this app, used for OAuth redirects.
APP_URL=http://localhost:3000

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts broker tokens at rest. Rotating it requires reconnecting cTrader.
TOKEN_ENCRYPTION_KEY=

# Shared secret for the pg_cron sync call: openssl rand -hex 32
# Must match the 'sync_secret' Vault secret in Supabase.
SYNC_SECRET=

# cTrader Open API app (https://openapi.ctrader.com). Redirect URI to register:
#   <APP_URL>/api/ctrader/callback
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
